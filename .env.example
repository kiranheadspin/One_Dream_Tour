NEXT_PUBLIC_DEMO_MODE=true
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (required when demo mode is false; use the publishable/anon key here)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Razorpay (server secrets must never use NEXT_PUBLIC_)
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Current manual UPI collection (server-rendered; not secrets)
PAYMENT_UPI_ID=
PAYMENT_UPI_PAYEE_NAME=One Dream Cup
PAYMENT_UPI_PHONE=

# Request protection (required when demo mode is false)
REQUEST_HASH_SECRET=

# Optional external bot-verification integration point
BOT_VERIFICATION_SECRET=
